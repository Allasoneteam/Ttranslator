# The user's data and downloads: never in the repository
/config.json
/data/
/models/
/engine/

# Built programs (made by source/build.sh and by the CI; attached to releases)
/Ttranslator.exe
/ttranslator-linux
/ttranslator-window.exe
/ttranslator-window-linux
/ttranslator-window

# Build and test leftovers (dist/: archives of source/release.sh)
/source/launcher/ui_fallback/
/dist/
__pycache__/
*.part

# Signing keys and their text copies: never in the repository. The Android release key lives with the author and in
# the GitHub environment android-signing (secrets); the open test key android/app/debug.keystore is tracked on purpose.
# On Windows the author's folder Tdoc\Android is the same folder as android\ here (letter case does not count).
*.p12
*.jks
*.pem
*.base64.txt
signing-key/
