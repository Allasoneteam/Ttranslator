<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ttranslator.app (macOS, 1.1). source/release-macos.sh puts the version of the launcher (appVersion) for @VERSION@.
     LSUIElement: the launcher (Contents/MacOS/Ttranslator) has no window and no Dock icon; the window program
     (Contents/MacOS/ttranslator-window) makes itself a regular app with the Dock icon and the menu bar.
     NSAllowsLocalNetworking: the window shows the pages of the launcher at http://127.0.0.1. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Ttranslator</string>
	<key>CFBundleExecutable</key>
	<string>Ttranslator</string>
	<key>CFBundleIconFile</key>
	<string>Ttranslator</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.allasoneteam.ttranslator</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ttranslator</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>de</string>
		<string>es</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.3</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (c) 2026 Allasoneteam and Ttranslator authors. MIT License</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
