<?xml version="1.0" encoding="utf-8"?>
<!-- Ttranslator for Android (feasibility prototype): one window with WebView; the launcher and the engine are
     programs started from the app's library folder, as on a computer. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- also needed for 127.0.0.1: the window talks to the launcher, the launcher to the engine -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- hasFragileUserData: when the app is removed, Android 10+ offers to keep its data (the models: gigabytes) -->
    <application
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Ttranslator"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Ttranslator">

        <!-- configChanges: turning the phone, the dark theme or the keyboard must not reload the page (the text in
             the fields would be lost) -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
